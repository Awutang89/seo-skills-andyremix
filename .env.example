# ---------------------------------------------------------------------------
# Marketing & SEO Skills — optional integrations
# Copy this file to ".env" and fill in the project's OWN keys. Every integration is
# optional; skills fall back to import-ready file output when a key is absent.
# NO keys are shipped with this package.
# ---------------------------------------------------------------------------

# Image / video generation (creative, seo-image-gen)
REPLICATE_API_TOKEN=

# Keyword data (keyword-research) — or use .dataforseo-config.json
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Content scoring (seo-content)
NEURONWRITER_API_KEY=
NEURONWRITER_PROJECT_ID=

# Publishing (faq-jsonld, seo-schema, shopify-collection-embed, seo-onpage-audit)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Email / analytics (optional — used by start-here tool detection)
MAILCHIMP_API_KEY=
CONVERTKIT_API_KEY=
GA4_MEASUREMENT_ID=
POSTHOG_API_KEY=

# Google Ads API (google-ads-audit, google-ads-create, google-ads-monitor, google-ads-optimize)
# — OAuth credentials go in the form the Google Ads client library expects;
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID only for an account reached through a manager account
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Search Console OAuth client file (gsc-audit) — the path only, never the file's contents
GSC_OAUTH_CLIENT_SECRETS_FILE=

# Social scheduler (social-content) — planned Zernio adapter, not active yet
ZERNIO_API_KEY=

# File: .env.example · Version 3.0.0 · November 2026
